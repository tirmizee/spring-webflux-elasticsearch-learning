# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Bootstrap password for the built-in 'elastic' superuser (used by docker-compose and to
# create the API key). Choose a strong value for anything beyond throwaway local use.
ELASTIC_PASSWORD=change-me-local-only

# The Elasticsearch API key used by the Spring Boot application, in ENCODED form, i.e. the
# value of the "encoded" field returned by the create-API-key API: base64(id:api_key).
# Leave empty until you have created a key (see README section 5).
ELASTICSEARCH_API_KEY=bjJlUGFLRUJoRldwSjlRU2JXQ0Y6aFoxdU1jcWxPUzVaSnFQcUZSclBfQQ==

# Optional overrides
# ELASTICSEARCH_URIS=http://localhost:9200
# SERVER_PORT=8081
