# Copy to `.env` and fill in real values. NEVER commit `.env`.

# Bootstrap password for the built-in 'elastic' superuser (docker-compose + API key creation).
ELASTIC_PASSWORD=change-me-local-only

# Encoded API key used by the application: the "encoded" field from the create-API-key API
# (base64(id:api_key)). Leave empty until created (see README).
ELASTICSEARCH_API_KEY=

# Optional overrides
# ELASTICSEARCH_URIS=http://localhost:9200
# SERVER_PORT=8082
